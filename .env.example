# Copy to .env (which git ignores) and fill in. Never commit .env.
# Create the key in the Voyager portal: https://voyager.rc.asu.edu (ASURITE login; ASU network or VPN to reach the portal).
VOYAGER_API_KEY=your-api-key-here
# Example value from ASU's public docs; must include /v1.
VOYAGER_BASE_URL=https://openai.rc.asu.edu/v1
# A model id from GET /v1/models (run: uv run structurer --source resumes --preflight).
VOYAGER_MODEL=your-model-id-here
